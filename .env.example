# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Single-user mode for v1: a fixed user id used for preferences/feedback.
# Replace with real auth (Supabase Auth) before going multi-user.
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001

# Required when deploying with Vercel Cron — protects /api/cron/generate.
# Generate with: openssl rand -hex 32
CRON_SECRET=replace-me

# Optional. When set, the Ad Desk pulls real classifieds from local subreddits
# via Reddit's read-only OAuth. Get a CLIENT_ID by registering an "installed app"
# at https://www.reddit.com/prefs/apps — name it anything, set redirect URI to
# http://localhost (unused), copy the string under your app's name. No client
# secret is required for installed apps; leave REDDIT_CLIENT_SECRET unset.
# If unset, classifieds fall back to AI-generated city-grounded copy.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
